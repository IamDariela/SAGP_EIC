rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user signed in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Get user's role from user_profiles
    function getUserRole() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role;
    }

    // Helper: Check if user has any of the specified roles
    function isUserInRoles(rolesList) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/user_profiles/$(request.auth.uid)) && 
             getUserRole() in rolesList;
    }

    // Helper: Is the user an admin?
    function isAdmin() {
      return isUserInRoles(['admin']);
    }

    // Helper: Is the user an authorized writer (admin, inventory, weapon or vehicle manager)?
    function isAuthorizedWriter() {
      return isUserInRoles(['admin', 'inventory_manager', 'weapon_manager', 'vehicle_manager']);
    }

    // Collections accessible by all signed-in users for reading, and authorized managers for writing
    match /locations/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAuthorizedWriter();
    }
    match /assets/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAuthorizedWriter();
    }
    match /people/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAuthorizedWriter();
    }
    match /assignments/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAuthorizedWriter() || isUserInRoles(['supervisor']);
    }
    match /maintenance/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAuthorizedWriter() || isUserInRoles(['supervisor', 'maintenance_staff']);
    }
    match /movements/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAuthorizedWriter();
    }
    match /aportes/{document=**} {
      allow read: if isSignedIn();
      allow write: if isUserInRoles(['admin', 'buyer', 'inventory_manager']);
    }
    match /projects/{document=**} {
      allow read: if isSignedIn();
      allow write: if isUserInRoles(['admin', 'buyer', 'inventory_manager']);
    }
    match /courses/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAuthorizedWriter() || isUserInRoles(['supervisor']);
    }
    match /drivers/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAuthorizedWriter() || isUserInRoles(['supervisor']);
    }
    match /notifications/{document=**} {
      allow read, write: if isSignedIn();
    }

    // User Profiles: Only accessible by the user themselves or an admin
    match /user_profiles {
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || request.auth.token.email in ['andy.padilla2@ujcv.edu.hn', 'cesarorellanaluissalinas@gmail.com']);
    }
    match /user_profiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email in ['andy.padilla2@ujcv.edu.hn', 'cesarorellanaluissalinas@gmail.com']);
      allow write: if isAdmin();
      allow update: if isAdmin();
    }
    
    // Audit Logs: Readable by authorized managers, writeable by signed-in users (to log actions)
    match /audit_logs/{logId} {
      allow read: if isAuthorizedWriter();
      allow create: if isSignedIn();
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
