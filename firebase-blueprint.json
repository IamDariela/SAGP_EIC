{
  "collections": {
    "locations": {
      "description": "Physical locations within the institution (buildings, offices, labs).",
      "fields": {
        "name": "string",
        "building": "string",
        "area": "string",
        "type": "string"
      }
    },
    "assets": {
      "description": "Individual items of institutional property including furniture, equipment, weapons, and vehicles.",
      "fields": {
        "code": "string",
        "name": "string",
        "description": "string",
        "category": "string",
        "brand": "string",
        "model": "string",
        "serial": "string",
        "locationId": "string",
        "status": "string",
        "type": "string",
        "details": "map",
        "currentAssignmentId": "string",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
    "movements": {
      "description": "History of asset transfers between locations.",
      "fields": {
        "assetId": "string",
        "fromLocationId": "string",
        "toLocationId": "string",
        "reason": "string",
        "userId": "string",
        "timestamp": "timestamp"
      }
    },
    "maintenance": {
      "description": "Record of maintenance actions for assets.",
      "fields": {
        "assetId": "string",
        "description": "string",
        "startDate": "timestamp",
        "endDate": "timestamp",
        "status": "string",
        "workDone": "string",
        "userId": "string"
      }
    },
    "assignments": {
      "description": "Records of assets assigned to individuals (weapons, vehicles, laptops).",
      "fields": {
        "assetId": "string",
        "personId": "string",
        "startDate": "timestamp",
        "endDate": "timestamp",
        "status": "string",
        "userId": "string",
        "observations": "string"
      }
    },
    "people": {
      "description": "Individuals who can receive assigned assets.",
      "fields": {
        "name": "string",
        "identification": "string",
        "department": "string"
      }
    },
    "audit_logs": {
      "description": "Log of all administrative actions.",
      "fields": {
        "action": "string",
        "entity": "string",
        "entityId": "string",
        "userId": "string",
        "timestamp": "timestamp",
        "details": "string"
      }
    },
    "user_profiles": {
      "description": "System user profiles and permissions.",
      "fields": {
        "role": "string",
        "email": "string",
        "name": "string"
      }
    }
